<%
  favicon_files = {
    'apple-touch-icon-precomposed' => %w[57 114 72 144 60 120 76 152],
    'favicon-purple' => %w[196 96 32 16 128],
    'mstile' => %w[144 70 150 310]
  }
  asset_host = Rails.configuration.x.site_settings.asset_host
%>
<% favicon_files.each do |prefix, sizes| %>
  <% sizes.each do |size| %>
    <% filename = "#{prefix}-#{size}x#{size}.png" %>
    <% next unless Rails.public_path.join(filename).exist? || Rails.root.join('app/assets/images', filename).exist? %>
    <% if prefix == 'apple-touch-icon-precomposed' %>
      <link rel="apple-touch-icon-precomposed" sizes="<%= size %>x<%= size %>" href="//<%= asset_host %>/<%= filename %>" />
    <% elsif prefix == 'favicon-purple' %>
      <link rel="icon" type="image/png" href="<%= asset_path(filename) %>" sizes="<%= size %>x<%= size %>" />
    <% elsif prefix == 'mstile' %>
      <meta name="msapplication-<%= size == 70 ? 'square70x70logo' : size == 150 ? 'square150x150logo' : size == 310 ? 'square310x310logo' : 'TileImage' %>" content="//<%= asset_host %>/<%= filename %>" />
    <% end %>
  <% end %>
<% end %>

<meta name="application-name" content="VIZAMYL™ Flutemetamol 18F Injection Electronic training programme" />
<meta name="msapplication-TileColor" content="#FFFFFF" />