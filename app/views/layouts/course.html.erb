<html class="no-js lt-ie10" lang="en">
<!--[endif]----><!--[if gt IE 9]><!--><!--<![endif]-->
<head></head>
<body class="course">
    <%= render partial: 'head' %>
  
    <%= tag(:meta, content: UserSerializer.new(current_user, scope: current_user).to_json, name: 'appData') %>
    <%= tag(:meta, content: Rails.application.secrets.asset_host, name: 'env-asset-host') %>
    <%= tag(:meta, content: Rails.application.secrets.content_host, name: 'env-content-host') %>
    <%= tag(:meta, content: Rails.env, name: 'env-environment') %>
    <%= render partial: 'ga' %>
    <%= render partial: 'rollbar' %>
    <%= render partial: 'pingdom' %>

    <script>
      window.I18n = window.I18n || {};
      window.I18n.translations = window.I18n.translations || {};
      window.I18n.translations["<%= I18n.locale %>"] = window.I18n.translations["<%= I18n.locale %>"] || {};
      window.I18n.translations["<%= I18n.locale %>"].layouts = {
        application: {
          copyright_html: <%= raw t('layouts.application.copyright_html').to_json %>,
          reference_html: <%= raw t('layouts.application.reference_html').to_json %>
        }
      };
    </script>

    <%= javascript_include_tag :course %>
  
</body></html>